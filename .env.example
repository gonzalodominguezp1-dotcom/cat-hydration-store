# Copy to .env and fill in. Never commit real secrets.
DATABASE_URL="postgresql://shop:shop@localhost:5432/shop"

# Public base URL used in payment redirects and emails.
APP_URL="http://localhost:3000"

# Stripe TEST keys only (sk_test_..., whsec_...). Live keys require Gonzalo's approval.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Safety switch: real supplier orders are blocked unless this is exactly "true".
ALLOW_REAL_SUPPLIER_ORDERS="false"

# Initial admin user created by `pnpm db:seed`.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me-please-123"
